# .env.example - COMMITTED placeholder, copy to .env and fill real values
# .env is gitignored - never commit real keys
# See main.py docstring for full env handling

# ThingSpeak (optional, for cloud path)
TS_CHANNEL=1234567
TS_READ_KEY=YOUR_READ_API_KEY_HERE
TS_WRITE_KEY=YOUR_WRITE_API_KEY_HERE

# Cloud guard (hours, 0 disables)
MAX_TS_AGE_HOURS=24
POLL_SEC=60

# Serial
SERIAL_PORT=/dev/ttyUSB0
# Windows: SERIAL_PORT=COM3

# App
STRING_ID=string1
DEMO=0
DEMO_HISTORY=0
